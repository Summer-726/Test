/* 首页样式 */

/* ===== AI 顾问入口卡（方案一：AI 是主角） ===== */
.ask-ai-card {
  margin: 32rpx 32rpx 0;
  background: linear-gradient(135deg, #0a84ff 0%, #1556e0 100%);
  border-radius: 28rpx;
  padding: 34rpx 36rpx;
  color: #ffffff;
  display: flex;
  align-items: center;
}

.ask-ai-left {
  flex: 1;
}

.ask-ai-title {
  font-size: 34rpx;
  font-weight: 600;
}

.ask-ai-sub {
  font-size: 24rpx;
  opacity: 0.92;
  margin-top: 10rpx;
}

.ask-ai-arrow {
  font-size: 44rpx;
  font-weight: 300;
  margin-left: 16rpx;
  opacity: 0.9;
}

/* ===== 日常/应急/存款状态卡 ===== */
.jar-card {
  margin-top: 32rpx;
}

.jar-label {
  font-size: 28rpx;
  color: #86868b;
}

.jar-remain {
  font-size: 76rpx;
  font-weight: 700;
  margin: 4rpx 0;
  line-height: 1.2;
}

.jar-used {
  font-size: 24rpx;
  color: #86868b;
}

/* 日常进度条 */
.progress-bar {
  height: 12rpx;
  background: #e5e5ea;
  border-radius: 999rpx;
  overflow: hidden;
  margin: 20rpx 0 12rpx;
}

.progress-fill {
  height: 100%;
  background: #0a84ff;
  border-radius: 999rpx;
}

.jar-meta {
  font-size: 24rpx;
  color: #86868b;
  margin-bottom: 18rpx;
}

.jar-sub {
  display: flex;
  align-items: center;
  border-top: 1rpx solid #f2f2f7;
  padding-top: 20rpx;
}

.jar-item {
  font-size: 26rpx;
  color: #1d1d1f;
  margin-right: 36rpx;
}

.jar-more {
  margin-left: auto;
  color: #0a84ff;
  font-size: 26rpx;
}

/* ===== 顾问提醒卡片 ===== */
.advisor-title {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 10rpx;
}

.advisor-text {
  font-size: 26rpx;
  color: #86868b;
}

/* ===== 最近消费（左滑撤回）===== */
/* 去掉卡片左右内边距，让滑动行贴到卡片边缘；overflow 裁剪圆角外的删除按钮 */
.recent-card {
  padding: 32rpx 0;
  overflow: hidden;
}

.recent-title {
  font-size: 30rpx;
  font-weight: 600;
  margin: 0 32rpx 12rpx;
}

.recent-empty {
  color: #86868b;
  font-size: 26rpx;
  margin: 0 32rpx;
  padding: 28rpx 0;
  text-align: center;
}

/* 行与行之间的分隔线（用相邻兄弟选择器，避免误伤第一行） */
.slide-wrap + .slide-wrap {
  border-top: 1rpx solid #f2f2f7;
}

.recent-item {
  display: flex;
  align-items: center;
  padding: 20rpx 32rpx;
}

.recent-left {
  flex: 1;
}

.recent-desc {
  font-size: 28rpx;
  color: #1d1d1f;
}

.recent-cat {
  font-size: 22rpx;
  color: #86868b;
  margin-top: 2rpx;
}

.recent-amount {
  font-size: 28rpx;
  font-weight: 500;
  color: #1d1d1f;
}

.recent-amount.income {
  color: #34c759;
}

<!-- 首页概览 -->

<!-- AI 顾问入口（方案一：AI 是主角，随时可咨询） -->
<view class="ask-ai-card" hover-class="pressed" bindtap="onAskAI">
  <view class="ask-ai-left">
    <view class="ask-ai-title">任何关于零钱的事，都可以问我</view>
    <view class="ask-ai-sub">AI 顾问 · 记账 / 预算 / 该不该买，随时咨询</view>
  </view>
  <view class="ask-ai-arrow">›</view>
</view>

<!-- 日常/应急/存款状态卡：点它进预算页 -->
<view class="card jar-card" hover-class="pressed" bindtap="goBudget">
  <view class="jar-label">日常</view>
  <view class="jar-remain">¥{{jar.flowerRemain}}</view>
  <view class="jar-used">本月已用 ¥{{jar.flowerUsed}} / 共 ¥{{jar.flowerTotal}}</view>

  <!-- 日常进度条 -->
  <view class="progress-bar">
    <view class="progress-fill" style="width: {{jar.percent}}%"></view>
  </view>

  <view class="jar-meta" wx:if="{{jar.flowerTotal !== '0.00'}}">剩 {{jar.daysLeft}} 天 · 日均还能花 ¥{{jar.avgDaily}}</view>
  <view class="jar-meta" wx:else>还没设置本月生活费，点下方「预算」先设置</view>

  <view class="jar-sub">
    <text class="jar-item">应急 ¥{{jar.rescue}}</text>
    <text class="jar-item">存款 ¥{{jar.savings}}</text>
    <text class="jar-more">预算 ›</text>
  </view>
</view>

<!-- 顾问提醒卡片（阶段 6c：文案按预算状态动态；点卡片随时进 AI 助手） -->
<view class="card advisor-card" hover-class="pressed" bindtap="onAskAI">
  <view class="advisor-title">💡 顾问提醒</view>
  <view class="advisor-text">{{advisorText}}</view>
</view>

<!-- 最近消费（左滑撤回） -->
<view class="card recent-card">
  <view class="recent-title">最近消费</view>
  <view wx:if="{{recent.length === 0}}" class="recent-empty">还没有记录，点底部「记账」开始第一笔～</view>

  <view class="slide-wrap {{item.id === openId ? 'is-open' : ''}}"
        wx:for="{{recent}}" wx:key="id" data-id="{{item.id}}"
        bindtouchstart="onTouchStart" bindtouchmove="onTouchMove" bindtouchend="onTouchEnd">
    <view class="slide-content"
          style="{{item.id === slideId ? 'transform: translateX(' + slideX + 'px);' : ''}}">
      <view class="recent-item">
        <view class="recent-left">
          <view class="recent-desc">{{item.desc}}</view>
          <view class="recent-cat">{{item.category}} · {{item.dateLabel}}</view>
        </view>
        <view class="recent-amount {{item.sign === '-' ? 'expense' : 'income'}}">{{item.sign}}¥{{item.amount}}</view>
      </view>
    </view>
    <!-- 删除按钮平时在容器右侧外被 overflow:hidden 裁掉，左滑吸附后才滑进可视区 -->
    <view class="slide-delete" data-id="{{item.id}}" catchtap="onDeleteEntry">撤回</view>
  </view>
</view>

/* ========== 全局样式：苹果风 ========== */
/* 配色、文字层级、组件规范见 docs/design.md */

page {
  background-color: #f5f5f7;   /* 页面浅灰底 */
  color: #1d1d1f;              /* 近黑正文 */
  font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", "PingFang SC", sans-serif;
  font-size: 28rpx;
  line-height: 1.5;
}

/* 通用白色圆角卡片 */
.card {
  background: #ffffff;
  border-radius: 28rpx;
  padding: 32rpx;
  margin: 24rpx 32rpx;
}

/* 页面大标题 */
.page-title {
  font-size: 44rpx;
  font-weight: 600;
  margin: 40rpx 32rpx 8rpx;
}

/* 页面副标题（灰） */
.page-sub {
  color: #86868b;
  font-size: 26rpx;
  margin: 0 32rpx 24rpx;
}

/* 苹果风主按钮（胶囊形） */
.btn-primary {
  background: #0a84ff;
  color: #ffffff;
  border-radius: 999rpx;
  text-align: center;
  padding: 24rpx 0;
  font-size: 32rpx;
  font-weight: 500;
}

/* 骨架期占位文字 */
.placeholder {
  color: #86868b;
  padding: 12rpx 0;
}

/* 点击按压反馈：可点元素加 hover-class="pressed"，按下时轻微变暗，松手回弹 */
.pressed {
  opacity: 0.7;
  transition: opacity 0.15s ease;
}

/* ===== 左滑删除/撤回：通用滑动机制（配套 utils/slideToDelete.js）=====
   删除按钮平时在容器右侧外（right:-80px），被 overflow:hidden 裁掉，
   所以平时界面绝对干净、不可能露红线；左滑吸附后（.is-open）按钮滑进可视区 */
.slide-wrap { position: relative; overflow: hidden; }
.slide-content {
  position: relative;
  z-index: 1;
  width: 100%;
  box-sizing: border-box;
  background: #fff;
  transition: transform 0.18s ease;
}
.slide-wrap.is-open .slide-content { transform: translateX(-80px); }
.slide-delete {
  position: absolute;
  top: 0;
  right: -80px;
  bottom: 0;
  width: 80px;
  background: #ff3b30;
  color: #fff;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: right 0.18s ease;
}
.slide-wrap.is-open .slide-delete { right: 0; }
